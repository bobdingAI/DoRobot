# DoRobot Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# GPUFree API Token (required for cloud training)
GPUFREE_BEARER_TOKEN=

# DoRobot API credentials (required for cloud training)
DOROBOT_API_URL=http://127.0.0.1:8000
DOROBOT_USERNAME=
DOROBOT_PASSWORD=

# Local data paths (optional)
DOROBOT_DATA_PATH=
DOROBOT_MODEL_OUTPUT=

# Edge server configuration (optional - for CLOUD=2 mode)
EDGE_SERVER_HOST=
EDGE_SERVER_USER=
EDGE_SERVER_PASSWORD=
EDGE_SERVER_PORT=22
EDGE_SERVER_PATH=
